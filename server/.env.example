# Server Configuration
# NODE_ENV: "development" for local, "production" for deployed hosting
NODE_ENV=development
# PORT: local server port to listen on
PORT=4000
# TRUST_PROXY: number of reverse proxies in front of app
#   Local direct run: 0
#   Typical single proxy (Render/Railway/Nginx): 1
TRUST_PROXY=0
# SERVER_URL: public URL of this server (used by Google OAuth callback)
#   Local: http://localhost:4000
#   Deployed: https://your-server-domain.com
SERVER_URL=http://localhost:4000

# Database
# MONGO_URI: MongoDB Atlas connection string
#   Get it from: MongoDB Atlas → Database → Connect → Drivers
MONGO_URI=your-mongodb-connection-string

# Session
# SESSION_SECRET: long random string (use a password generator, 32+ chars)
SESSION_SECRET=your-session-secret

# Client URL (frontend)
# CLIENT_URL: the primary frontend origin (local or deployed)
CLIENT_URL=http://localhost:5173
# Optional: allow multiple origins separated by commas
# CLIENT_ORIGINS=http://localhost:5173,https://your-frontend-domain.com
# Optional: regex for dynamic preview domains (advanced)
# CLIENT_ORIGIN_REGEX=^https://[a-z0-9-]+-your-project\.vercel\.app$

# Google OAuth
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET:
#   Get from Google Cloud Console → APIs & Services → Credentials → OAuth Client ID
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# AI Services (Gemini)
# SUMMARY_API_KEY / QUIZ_API_KEY:
#   Get from Google AI Studio (Gemini API key)
SUMMARY_API_KEY=your-gemini-api-key
QUIZ_API_KEY=your-gemini-api-key

# YouTube Data API
# YOUTUBE_API_KEY:
#   Get from Google Cloud Console → Enable YouTube Data API v3 → API key
YOUTUBE_API_KEY=your-youtube-api-key

# Optional: transcript service language preference (comma-separated)
TRANSCRIPT_LANGS=en,en-US,en-GB,en-IN,hi

# Optional: override python executable for transcript scripts (python3/python/py)
PYTHON_BIN=python
