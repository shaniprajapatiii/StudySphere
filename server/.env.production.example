NODE_ENV=production
PORT=4000
TRUST_PROXY=1

SERVER_URL=https://your-backend-domain.com
CLIENT_URL=https://your-frontend-domain.com
# Optional if you need to allow additional frontend origins
# CLIENT_ORIGINS=https://your-frontend-domain.com,https://your-custom-domain.com
# Optional for preview deployments (advanced regex allow-list)
# CLIENT_ORIGIN_REGEX=^https://[a-z0-9-]+-your-project\.vercel\.app$

MONGO_URI=your-mongodb-connection-string
SESSION_SECRET=replace-with-a-long-random-secret-32-plus-chars

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

SUMMARY_API_KEY=your-gemini-api-key
QUIZ_API_KEY=your-gemini-api-key
YOUTUBE_API_KEY=your-youtube-api-key

PYTHON_BIN=python
TRANSCRIPT_LANGS=en,en-US,en-GB,en-IN,hi
TRANSCRIPT_PROXIES=
