# Frontend (Vite) Environment Variables
# Public site URL used for canonical links and SEO metadata.
# Local example: http://localhost:5173
# Production example: https://your-frontend-domain.com
VITE_SITE_URL=http://localhost:5173

# BASE URL used by frontend API/auth requests in browser runtime.
# Local development example: http://localhost:4000
# Production example: https://your-backend-domain.com
VITE_API_BASE_URL=http://localhost:4000